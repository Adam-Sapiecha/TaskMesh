# Generate three independent random values: openssl rand -hex 32
# Use URL-safe hex for database passwords (they are part of DATABASE_URL).
POSTGRES_PASSWORD=
TASKMESH_DB_PASSWORD=
TASKMESH_API_KEY=
TASKMESH_HTTP_PORT=8084
TASKMESH_VERSION=local
WORKER_CONCURRENCY=2
# Public endpoint is not yet configured. This is an explicit placeholder.
TASKMESH_PUBLIC_URL=https://taskmesh.YOUR-DOMAIN.example
